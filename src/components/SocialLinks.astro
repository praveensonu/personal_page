---
import type { ProfileLink } from '../data/profile';
interface Props { links: ProfileLink[] }
const { links } = Astro.props;
const icons: Record<ProfileLink['kind'], string> = {
  scholar: '<path d="M12 3 2 9l10 6 10-6-10-6Zm-6.5 8.1V16c0 1.7 2.9 3 6.5 3s6.5-1.3 6.5-3v-4.9L12 15l-6.5-3.9Z"/>',
  github: '<path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.8.1-.7.4-1.1.6-1.3-2.3-.3-4.7-1.1-4.7-5A3.9 3.9 0 0 1 6.6 8.6c-.1-.3-.5-1.3.1-2.7 0 0 .9-.3 2.8 1.1a9.6 9.6 0 0 1 5.1 0c2-1.4 2.8-1.1 2.8-1.1.6 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1.1 2.8c0 3.9-2.4 4.7-4.7 5 .4.3.7 1 .7 2V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/>',
  linkedin: '<path d="M5.2 8.4H2V22h3.2V8.4ZM3.6 2A1.9 1.9 0 1 0 3.6 5.8 1.9 1.9 0 0 0 3.6 2ZM22 14.2c0-4.1-2.2-6-5.1-6a4.4 4.4 0 0 0-4 2.2v-2H9.7V22h3.2v-6.7c0-1.8.3-3.5 2.6-3.5s2.3 2.1 2.3 3.6V22H22v-7.8Z"/>',
  email: '<path d="M3 5h18v14H3V5Zm9 7.2L19.2 7H4.8l7.2 5.2Zm0 2.4L5 9.5V17h14V9.5l-7 5.1Z"/>',
  cv: '<path d="M6 2h9l5 5v15H6V2Zm8 2v5h4l-4-5Zm-5 9h8v-2H9v2Zm0 4h8v-2H9v2Z"/>',
};
---
<ul class="social-links" aria-label="Profile links">
  {links.map((link) => <li><a href={link.href} target={link.kind === 'email' ? undefined : '_blank'} rel="me noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[link.kind]}></svg><span>{link.label}</span></a></li>)}
</ul>
